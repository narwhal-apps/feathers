{
  "name": "feathers",
  "version": "0.6.1",
  "description": "A Tauri 2 + SvelteKit desktop Git client for macOS.",
  "author": {
    "name": "Mikael Kristianson"
  },
  "repository": {
    "url": "https://github.com/narwhal-apps/feathers",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/narwhal-apps/feathers/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/geist-mono": "5.2.8",
    "@fontsource/geist-sans": "5.2.5",
    "@lucide/svelte": "1.14.0",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-opener": "2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.3",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "diff": "9.0.0",
    "shiki": "4.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.3.1",
    "@vitest/ui": "4.1.5",
    "jsdom": "29.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sveltejs/kit",
      "esbuild"
    ]
  }
}
